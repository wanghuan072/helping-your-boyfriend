{
  "name": "helping-your-boyfriend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:paths && npm run test:build-artifacts && npm run validate:publish && node scripts/seo/build.mjs && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:content": "node scripts/test-content-contract.mjs",
    "test:dates": "node scripts/test-page-fingerprints.mjs",
    "test:paths": "node scripts/test-path-policy.mjs",
    "test:sitemap": "node scripts/test-sitemap-output.mjs",
    "validate:data": "node scripts/validate-data.mjs development",
    "validate:media": "node scripts/validate-data.mjs media",
    "validate:publish": "node scripts/validate-data.mjs publish",
    "sitemap:update": "npm run build",
    "sitemap:validate": "node scripts/seo/build.mjs validate",
    "content:dates:update": "node scripts/sitemap-state.mjs update",
    "content:dates:validate": "node scripts/sitemap-state.mjs validate",
    "seo:migrate": "node scripts/seo/build.mjs migrate",
    "test:seo": "node scripts/seo/test.mjs && node scripts/seo/test-github-checkpoint.mjs",
    "test:build-artifacts": "node scripts/seo/test-build-artifacts.mjs",
    "indexnow:verify-key": "node scripts/seo/verify-key.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "audit:viewports": "node scripts/capture-acceptance-viewports.mjs"
  },
  "dependencies": {
    "@next/env": "16.4.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "parse5": "^8.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
